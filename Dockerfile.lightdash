# Use the official Lightdash image as the base
FROM lightdash/lightdash:latest

# Install the Lightdash CLI and tslib (needed at runtime)
RUN npm install -g @lightdash/cli tslib

# Install curl for health checks (if you really need it)
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
